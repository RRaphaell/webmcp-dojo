{
  "name": "webmcp-dojo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Dojo: a website that tests the AI agent visiting it. Built for the OpenAI WebMCP Challenge.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node tests/run.mjs",
    "eval": "node evals/run.mjs",
    "deploy": "npm run build && wrangler deploy && node scripts/check-live.mjs",
    "check:live": "node scripts/check-live.mjs",
    "evals:budget": "node evals/budget-check.mjs",
    "evals:schema": "node evals/export-schema.mjs",
    "evals:capture": "node scripts/capture-evals.mjs",
    "evals:detail": "node scripts/ladder-detail.mjs",
    "tables": "node scripts/belt-table.mjs",
    "evals:suite": "node evals/run.mjs --suite evals/dojo.evals.json"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0"
  }
}
